# Vite fingerprints everything under /assets, so those are safe to pin forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The icons and the embed image are stable but not fingerprinted — a day, so a
# change still propagates without a week of stale link previews.
/og.jpg
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
/favicon-96.png
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/icon-192.png
  Cache-Control: public, max-age=86400
/icon-512.png
  Cache-Control: public, max-age=86400

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
